# ==============================================================================
# Environment Configuration Template - IBM Z Datathon 2026
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ==============================================================================

# Application Environment (production, development, testing)
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Persistence Configuration
# SQLite persistent storage (mapped to container volume):
DATABASE_URL=sqlite:////app/data/claims.db
# PostgreSQL alternative (if provisioned):
# DATABASE_URL=postgresql://user:password@db-host:5432/claims_db

# ML Model Artifacts (Member 1 Integration)
MODEL_ARTIFACT_PATH=backend/models/risk_model.joblib
MODEL_METADATA_PATH=backend/models/metadata.json
# Strict validation in production: false ensures real artifact must be loaded
ALLOW_MOCK_MODEL=false

# Risk Threshold Boundaries
RISK_THRESHOLD_LOW=0.427
RISK_THRESHOLD_HIGH=0.610

# Security & CORS Origins
REQUIRE_AUTH=false
API_KEY=
CORS_ORIGINS=*

# Frontend Environment Variables (Embedded into React client at build time)
VITE_API_BASE_URL=/api
