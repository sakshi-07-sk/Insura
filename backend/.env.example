# ==============================================================================
# Insurance Claim Risk Scoring Backend - Environment Configuration Template
# IBM Z Datathon 2026 - LinuxONE Target
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./claims.db
# Production / LinuxONE: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://insurance_user:replace_with_secure_password@postgres:5432/insurance_db
DB_ECHO=false

# Machine Learning Model Integration (Member 1 Handover)
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib
MODEL_METADATA_PATH=ml/artifacts/metadata.json
# Set to false in production to ensure real model artifact is enforced
ALLOW_MOCK_MODEL=true

# Risk Category Threshold Boundaries
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70

# Security & Reviewer Access Control
# Set to true in production deployments to enforce authentication
REQUIRE_AUTH=false
API_KEY=replace_with_strong_reviewer_api_key_for_production

# CORS Configuration (Comma-separated origins for Member 3's React Frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
